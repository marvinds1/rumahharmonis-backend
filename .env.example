MONGODB_URI=mongodb://localhost:27017/rumahharmonis_backend
ACCESS_TOKEN_SECRET=change-me-min-32-chars
REFRESH_TOKEN_SECRET=change-me-another-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=1d
# Comma-separated list of frontend origins allowed to call the API with cookies ("*" is rejected)
CORS_ORIGIN=http://localhost:3000
# Number of reverse proxies in front of the app (0 = none). Controls which IP the rate limiter sees.
TRUST_PROXY=1
PORT=8000
